root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.{png,ico,jpg,jpeg,webp}]
insert_final_newline = false
